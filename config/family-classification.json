  "size_bucket_definitions": {
    "small": {
      "parameters_b_range": "< 12B",
      "description": "Utility-tier models. Default for cleanup, classification, RAG planner."
    },
    "midsize": {
      "parameters_b_range": "12B - 50B",
      "description": "Power-user override slot. No auto-population from this bucket."
    },
    "large": {
      "parameters_b_range": ">= 50B",
      "description": "Workhorse-tier models. Default for depth/breadth/consolidation/verification."
    },
    "free": {
      "parameters_b_range": "any",
      "description": "Parallel free-models list. Cost-tier 0. Never mixed into paid ranking."
    }
  }
