# Machine-specific configuration (generated by setup.sh from templates)
config.json
config/endpoints.json
config/models.json
config/interface.json
config/browser-sessions/
config/browser-profiles/
config/session-refresh.log

# User-generated content
mind.md
frameworks/personal/
agents/*.md
!agents/agent-registry.md

# Large binaries (each user downloads their own)
models/

# User-specific data
chromadb/
reconciliation/

# knowledge/ was ignored in the initial commit (2026-04-01), when it held only
# user-specific runtime state. The mental-model lenses did not exist yet — the
# earliest is dated 2026-06-17 — and simply landed in an already-ignored folder.
# They are not user data: Ora's analytical functions require them, exactly as
# they require modes/, which has always shipped. Anyone cloning this repo needs
# both or the analysis does not work. Canonical source for both is the vault
# (vault/Lenses, vault/Modes), mirrored to the runtime tree and committed here.

# Derived indexes (regenerable from canonical YAML in vault)
data/*.db
data/*.db-shm
data/*.db-wal
data/chroma/
data/entity-index.json
data/vault-index.json
data/extraction-staging/
data/extraction-promoted/
data/conversation-manifest.jsonl

# Historical corpus-pipeline resume checkpoints (orchestrator/historical/*).
# Regenerable; read only by the one-time migration scripts to skip completed
# work, never by the live runtime. Untracked 2026-05-30 (~61 MB).
data/*-manifest.json
data/chain-index.json
data/compaction-events.jsonl
data/session-logs/
data/hector-training-corpus/

# Per-turn pipeline forensic traces (volatile diagnostic output).
# Regenerable from any pipeline run; can grow large.
data/pipeline-traces/

# Conversation chunk indexing-failure log (privacy-relevant — captures
# conversation_id and error context for ChromaDB indexing failures).
# Stealth conversations skip the write; non-stealth conversations have
# their entries removed by _purge_stealth Layer 7 on deletion.
data/conversation-indexing-failures.jsonl

# Per-session runtime state (conversations, canvas snapshots, uploads)
sessions/

# Active-configuration pointer + preset toggle state (per-machine runtime
# selection). Loader falls back to "user-pipeline" / baked presets if absent
# (orchestrator/active_configuration.py).
data/active-configuration.json
data/preset-toggles.json

# Meta-layer oversight runtime state (heartbeats, event logs, router log,
# corpus state, workflow pointers — daemon auto-registers PEDs and workflow
# specs at startup, so these are regenerable)
data/oversight/

# Project plugin pointer files (Reference — Ora Project Plugin Convention.md).
# Ora core ships project-agnostic; pointer files are per-machine local
# configuration written by /project-register or pr.register_project().
data/projects/

# MSI feed-data cache (raw GDELT downloads, regenerable)
scripts/msi/cache/

# Generated per machine
ai
ai.app/
*.app/
config/icons/*.icns

# Claude Desktop preview configuration is generated per checkout. Keeping it
# machine-local prevents one worktree from launching another checkout and lets
# each OS select its own Python interpreter. Use launch.json.example as the
# canonical profile template and replace its explicit interpreter placeholder.
/.claude/launch.json

# Machine-specific reports (generated by installer and upgrades)
docs/hardware-report.md
docs/upgrade-report*.md
docs/pre-upgrade-packages.txt

# Logs and caches
logs/
*.log
__pycache__/
*.pyc
.DS_Store

# macOS launcher variants (generated per machine)
*.command

# Drift framework backups
*.bak*
~/

# Pre-change backup tarballs (e.g. backups/msi-news-prestamp-*.tar.gz)
backups/

# --- 2026-05-28 server-side hygiene ---
# Server-side ChromaDB lives at orchestrator/chroma_db/ (different path
# than the existing chromadb/ rule). Untrack so it doesn't bloat commits.
orchestrator/chroma_db/

# Server-only venv (each machine builds its own).
.venv/

# Node test dependencies (reinstall from package-lock.json with `npm ci`).
# No trailing slash: with one this matches directories only, and a SYMLINK
# named node_modules slips past it. That happened in 688f679d — a worktree's
# jsdom symlink was committed, pointed at its own path once merged, and broke
# every JS suite from a clean checkout (fixed in e256a7cd).
**/node_modules

# Server-side data caches (regenerable from canonical sources).
cache/

# Routing-config + capabilities one-shot backup files left by prior tuning
# sessions. Keep them on disk for recovery but never commit.
config/*.pre-*
config/*.bak-*
config/configurations/*.bak-*
vault-sync/

# Machine-specific embedder + collection-name config. Each machine (Mac on
# bge-m3, server on nomic during a migration window, forks on defaults) keeps
# its own. Tracked documentation lives in config/chromadb.json.template; the
# live file is gitignored so machines don't clobber each other via git.
config/chromadb.json
data/campaign/
config/configurations/campaign-*.json
data/visual-emission-log.jsonl
data/maintenance-state.json
data/maintenance-results.jsonl
# Live runtime overlays, including user-pipeline configuration edits.
data/runtime/
data/claude-code-runs/
# Isolated ChatGPT/Codex OAuth runtime state and local SDK databases.
data/codex-subscription/

# Generated preview artifact (PR-A vendor-authoritative registry build)
config/model-registry.vendor-authoritative.json

# Execution Review runtime state (per-machine, regenerable). The tool-event log
# is the Phase-1 global sink (orchestrator/tool_events.py global_sink_path); the
# approval store + its lock are the Phase-2 task-approval tokens (risk_gate.py);
# the execution-records store is the Phase-7 tiered-persistence ledger + durable
# notes (orchestrator/execution_persistence.py). That store MUST stay git-ignored:
# its stealth-purge (conversation_closeout) rmtree's records for TRUE zero-residue,
# which a file committed to git history would defeat.
data/tool-events.jsonl
data/execution-approvals.json
data/execution-approvals.json.lock
data/execution-approvals.json.auth.key
data/execution-records/
data/trace-debug/
data/lifecycle-locks/
data/runtime-hygiene/
data/*.lock
data/**/*.lock
scratch/

# Per-machine runtime pointers + user stores (like data/active-configuration.json).
data/active-project.json
data/custom-styles.json

# Retention-sweeper archive of rotated runtime logs (regenerable; see
# orchestrator/retention_sweeper.py — data/*.jsonl rotated here when oversized).
data/archive/

# Conversation-to-project association: derived retrieval artifacts. Both are
# regenerable from data/conversation-segments/ plus the vector index, and
# together they are ~80 MB. The judged verdicts under
# data/conversation-projects/judge-output/ are NOT derived and are kept.
data/conversation-projects/candidates.json
data/conversation-projects/judge-input/
data/conversation-projects/verify-input/
data/conversation-projects/sweep-input-unretrieved/
data/conversation-projects/sweep-input-all/
data/conversation-projects/verify-works/
data/conversation-projects/rerun-batches.json
