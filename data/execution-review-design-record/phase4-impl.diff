+# ── risk_gate integration — single fold, output_type + consistency recorded ─
+class TestRiskGateWiring(unittest.TestCase):
+    def _trace_with(self, *events):
+        d = tempfile.mkdtemp()
+        with open(os.path.join(d, "tool-events.jsonl"), "w") as f:
