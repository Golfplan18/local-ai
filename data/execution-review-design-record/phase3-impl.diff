+# read here + substantive output ⇒ source read (over-route is safe, §6). Never
+# subject to any local read-vs-context tie-break.
+_ALWAYS_SOURCE_ACTIONS = frozenset({
+    "web_fetch", "web_search", "knowledge_search", "rag_read"})
