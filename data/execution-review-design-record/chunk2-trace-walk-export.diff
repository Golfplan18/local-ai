+    try {
+      const c = controllerFor('pin');
+      const r = await fetch('/api/trace/retention', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ trace_ref: ref, pinned: target }),
+        signal: c.signal,
