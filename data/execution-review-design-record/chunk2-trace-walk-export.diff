+      detail.innerHTML = '<h2>' + esc(data.step_name) + ' - ' + esc(data.label) + '</h2>'
+        + (errors ? '<ul class="ora-trace-error">' + errors + '</ul>' : '')
+        + '<div class="ora-trace-markdown">' + (data.markdown ? md(data.markdown) : '<p>No Markdown sibling recorded.</p>') + '</div>'
