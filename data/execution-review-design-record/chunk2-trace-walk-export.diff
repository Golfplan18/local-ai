+def _step_role_label(step_name: str) -> str:
+    if step_name in _STEP_LABELS:
+        return _STEP_LABELS[step_name]
+    stem = step_name
+    if stem.startswith("step"):
+        stem = stem[4:]
+    return stem.replace("-", " ").strip().title() or step_name
