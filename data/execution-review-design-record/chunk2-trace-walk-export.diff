+                payload = html.escape(json.dumps(step.get("payload"), indent=2, default=_json_default), quote=True) if step.get("payload") is not None else ""
+                errors = "".join(f"<li>{html.escape(e, quote=True)}</li>" for e in step.get("errors") or [])
+                sections.append(
+                    "<section class=\"step\">"
