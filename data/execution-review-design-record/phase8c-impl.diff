+    lines = [f"DEPLOY PROBE (informational — not a convergence input in this "
+             f"phase) [{state}]",
+             f"  probes: PASS={counts.get('PASS', 0)} FAIL={counts.get('FAIL', 0)}"
+             f" INDETERMINATE={counts.get('INDETERMINATE', 0)}"]
+    if durable_summary:
