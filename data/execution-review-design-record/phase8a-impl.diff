+    def tearDown(self):
+        te._TURN_CTX.reset(self._ctx_token)
+        for k, v in self._saved.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        self.tmp.cleanup()
+        super().tearDown()
