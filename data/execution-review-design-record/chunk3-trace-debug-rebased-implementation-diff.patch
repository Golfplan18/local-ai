+        pipeline_trace.append_jsonl(parent, "model-call-config.jsonl", {"step": "step1-phase-a", "provider": "p", "model_id": "m", "effective_max_tokens": 10})
+        pipeline_trace.update_manifest_fields(parent, contract_snapshot={"capture_status": "captured", "canonical_fields": {"mode": "P-Debug"}, "fingerprint": "abc"})
